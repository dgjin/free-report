# Required in production. Use a long, randomly generated secret.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated browser origins allowed in production.
CORS_ORIGINS="https://reports.example.com"

# Existing MySQL instance. Copy this file to .env and fill in real values.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="free_report"
MYSQL_USER="free_report_app"
MYSQL_PASSWORD="replace-with-database-password"
MYSQL_SSL="false"

# 智能问数使用的大模型服务（OpenAI 兼容协议，POST {AI_BASE_URL}/chat/completions）
# 生产（DeepSeek）:
#   AI_BASE_URL="https://api.deepseek.com/v1"
#   AI_MODEL="deepseek-chat"
#   AI_API_KEY="replace-with-deepseek-api-key"
# 本地测试（Ollama，先 ollama pull 好模型并保持 ollama 服务运行）:
AI_ENABLED="true"
AI_BASE_URL="http://localhost:11434/v1"
AI_API_KEY="ollama"
AI_MODEL="qwen3.6:latest"
# 本地模型较慢，超时建议放宽到 180 秒
AI_TIMEOUT="180"
# 思考型模型（qwen3 等）可用 none/low/medium/high 控制思维链长度，留空表示交给服务端默认
AI_REASONING_EFFORT="low"
