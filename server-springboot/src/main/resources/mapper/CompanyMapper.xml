<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.freereport.mapper.CompanyMapper">

    <!-- 查询所有机构 -->
    <select id="findAll" resultType="com.freereport.entity.Company">
        SELECT * FROM companies ORDER BY id
    </select>

    <!-- 根据编码查询机构（数据导入按 company_code 定位） -->
    <select id="findByCode" resultType="com.freereport.entity.Company">
        SELECT * FROM companies WHERE code = #{code}
    </select>

    <!-- 根据 ID 查询机构 -->
    <select id="findById" resultType="com.freereport.entity.Company">
        SELECT * FROM companies WHERE id = #{id}
    </select>

    <!-- 根据 ID 列表批量查询机构 -->
    <select id="findByIds" resultType="com.freereport.entity.Company">
        <choose>
            <when test="ids != null and ids.size() > 0">
                SELECT * FROM companies WHERE id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                SELECT * FROM companies WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <!-- 查询所有 active 的 branch -->
    <select id="findBranches" resultType="com.freereport.entity.Company">
        SELECT * FROM companies WHERE level = 'branch' AND status = 'active'
    </select>

    <!-- 查询可下发目标机构 -->
    <select id="findAssignmentTargets" resultType="com.freereport.entity.Company">
        SELECT * FROM companies
        WHERE status = 'active'
          AND level IN ('department', 'branch')
          AND (#{excludeId} IS NULL OR id &lt;&gt; #{excludeId})
        ORDER BY level, name
    </select>

    <!-- 创建机构（返回包含生成的 ID） -->
    <insert id="createCompany" parameterType="map"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO companies (name, code, parent_id, level)
        VALUES (#{name}, #{code}, #{parentId}, #{level})
    </insert>

    <!-- 查询该机构未完成任务数（用于停用前检查） -->
    <select id="countActiveAssignments" resultType="int">
        SELECT COUNT(*) FROM report_assignments
        WHERE assigned_to_company_id = #{companyId}
          AND status NOT IN ('received', 'approved', 'aggregated', 'rejected')
    </select>

    <!-- 停用机构（总部不可停用） -->
    <update id="disableCompany">
        UPDATE companies
        SET status = 'inactive'
        WHERE id = #{id}
          AND level &lt;&gt; 'headquarter'
    </update>

</mapper>
