<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.freereport.mapper.UserMapper">

    <!-- 根据 ID 查询用户 -->
    <select id="findById" resultType="com.freereport.entity.User">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <!-- 根据用户名查询用户（大小写不敏感，数据库 collation utf8mb4_0900_ai_ci 已保证） -->
    <select id="findByUsername" resultType="com.freereport.entity.User">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <!-- 查询所有用户 -->
    <select id="findAll" resultType="com.freereport.entity.User">
        SELECT * FROM users ORDER BY id
    </select>

    <!-- 根据 ID 列表批量查询用户 -->
    <select id="findByIds" resultType="com.freereport.entity.User">
        <choose>
            <when test="ids != null and ids.size() > 0">
                SELECT * FROM users WHERE id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </when>
            <otherwise>
                SELECT * FROM users WHERE 1 = 0
            </otherwise>
        </choose>
    </select>

    <!-- 查询用户所属公司（用于 auth filter 刷新公司信息） -->
    <select id="findCompanyById" resultType="com.freereport.entity.Company">
        SELECT * FROM companies WHERE id = #{id}
    </select>

    <!-- 根据机构 ID 查询该机构下所有用户 ID（用于缓存失效） -->
    <select id="findIdsByCompanyId" resultType="java.lang.Long">
        SELECT id FROM users WHERE company_id = #{companyId}
    </select>

    <!-- 更新用户机构和角色 -->
    <update id="updateUserOrganizationRole">
        UPDATE users
        SET company_id = #{companyId},
            role = #{role}
        WHERE id = #{id}
    </update>

</mapper>
